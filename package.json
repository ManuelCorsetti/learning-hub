{
  "name": "learning-studio",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --disable-warning=ExperimentalWarning --import tsx backend/src/server.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx --disable-warning=ExperimentalWarning backend/src/server.ts",
    "db:migrate": "tsx --disable-warning=ExperimentalWarning backend/scripts/migrate.ts",
    "db:seed": "tsx --disable-warning=ExperimentalWarning backend/scripts/seed.ts",
    "db:reset": "tsx --disable-warning=ExperimentalWarning backend/scripts/reset.ts",
    "db:replay": "tsx --disable-warning=ExperimentalWarning backend/scripts/replay.ts",
    "ai:smoke": "tsx --disable-warning=ExperimentalWarning backend/scripts/ai-smoke.ts",
    "ai:lesson": "tsx --disable-warning=ExperimentalWarning backend/scripts/generate-lesson.ts",
    "ai:runs": "tsx --disable-warning=ExperimentalWarning backend/scripts/ai-runs.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.0",
    "@dagrejs/dagre": "3.1.1",
    "@hono/node-server": "2.1.3",
    "@xyflow/react": "12.12.0",
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-fsrs": "5.4.2",
    "uuid": "14.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
